PORT=3000
DATABASE_URL=postgresql://user:password@postgres:5432/nidal_content
DATABASE_SSL=false
CORS_ORIGIN=
APP_ACCESS_TOKEN=
DEMO_MODE=true

# --- Authentication JWT (laisser JWT_SECRET vide pour desactiver) ---
JWT_SECRET=
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=
DEFAULT_ADMIN_EMAIL=admin@gsnidal.ma

# --- Intelligence Artificielle ---
# Fournisseur serveur prioritaire : Google Gemini.
# OpenRouter sert de fallback automatique si Gemini échoue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback multi-modèles
# Obtenez une clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
# "openrouter/free" permet de laisser OpenRouter choisir un modèle gratuit disponible.
OPENROUTER_MODEL=openrouter/free

# Alternatives optionnelles
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Meta Graph API & Meta Ads (En attente - optionnel) ---
# A renseigner plus tard des que vous avez vos identifiants Meta
META_GRAPH_VERSION=v26.0
META_ACCESS_TOKEN=
META_PAGE_ID_NIDAL=
META_PAGE_ID_NIDAL_JUNIOR=
META_IG_USER_ID_NIDAL=
META_IG_USER_ID_NIDAL_JUNIOR=
META_AD_ACCOUNT_ID_NIDAL=
META_AD_ACCOUNT_ID_NIDAL_JUNIOR=
META_PAGE_POST_METRICS=post_media_view,post_total_media_view_unique
# Cache serveur pour le dashboard Meta Live (le navigateur actualise chaque minute)
META_LIVE_CACHE_SECONDS=60


# --- Automatisation KPI -> IA ---
# Secret dédié au webhook POST /webhooks/kpi-ai
NIDAL_WEBHOOK_SECRET=
