PORT=3000
DATABASE_URL=postgresql://user:password@postgres:5432/nidal_content
DATABASE_SSL=false
CORS_ORIGIN=
APP_ACCESS_TOKEN=
DEMO_MODE=true

# --- Authentication JWT (laisser JWT_SECRET vide pour desactiver) ---
JWT_SECRET=
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=
DEFAULT_ADMIN_EMAIL=admin@gsnidal.ma

# --- Intelligence Artificielle (OpenRouter gratuit ou OpenAI) ---
# Obtenez une cle gratuite sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modeles recommandes :
# meta-llama/llama-3.3-70b-instruct (payant/standard)
# deepseek/deepseek-r1:free (gratuit)
# google/gemini-2.0-flash-exp:free (gratuit)
# qwen/qwen-2.5-72b-instruct:free (gratuit)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Alternative OpenAI (si cle OpenAI disponible)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Meta Graph API & Meta Ads (En attente - optionnel) ---
# A renseigner plus tard des que vous avez vos identifiants Meta
META_GRAPH_VERSION=v26.0
META_ACCESS_TOKEN=
META_PAGE_ID_NIDAL=
META_PAGE_ID_NIDAL_JUNIOR=
META_IG_USER_ID_NIDAL=
META_IG_USER_ID_NIDAL_JUNIOR=
META_AD_ACCOUNT_ID_NIDAL=
META_AD_ACCOUNT_ID_NIDAL_JUNIOR=
META_PAGE_POST_METRICS=post_media_view,post_total_media_view_unique
