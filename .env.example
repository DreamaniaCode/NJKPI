PORT=3000
DATABASE_URL=postgresql://user:password@postgres:5432/nidal_content
DATABASE_SSL=false
CORS_ORIGIN=
APP_ACCESS_TOKEN=
DEMO_MODE=true
# URL publique du dashboard, utilisée pour générer les URLs médias accessibles par Meta.
PUBLIC_BASE_URL=https://nidal.myskillscloud.com
# En production Coolify, montez un volume persistant sur ce dossier.
MEDIA_UPLOAD_DIR=/data/nidal-uploads
MEDIA_UPLOAD_LIMIT=50mb

# --- Authentication JWT (laisser JWT_SECRET vide pour desactiver) ---
JWT_SECRET=
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=
DEFAULT_ADMIN_EMAIL=admin@gsnidal.ma
# Mettre true pour un seul déploiement afin de réinitialiser le compte ci-dessus, puis repasser à false.
RESET_DEFAULT_ADMIN=false

# --- Intelligence Artificielle ---
# Fournisseur serveur prioritaire : Google Gemini.
# OpenRouter sert de fallback automatique si Gemini échoue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback multi-modèles
# Obtenez une clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
# "openrouter/free" permet de laisser OpenRouter choisir un modèle gratuit disponible.
OPENROUTER_MODEL=openrouter/free

# Alternatives optionnelles
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Alibaba Cloud Model Studio (OpenAI-compatible)
ALIBABA_API_KEY=
ALIBABA_MODEL=qwen3.8-flash
# Utilisez de préférence l'URL compatible de votre workspace/région.
# Exemple Singapore : https://<WORKSPACE_ID>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b

# --- Meta Graph API & Meta Ads (En attente - optionnel) ---
# A renseigner plus tard des que vous avez vos identifiants Meta
META_GRAPH_VERSION=v26.0
META_ACCESS_TOKEN=
META_PAGE_ID_NIDAL=
META_PAGE_ID_NIDAL_JUNIOR=
# Optionnel : Page Access Token dédié. Sinon NJKPI tente de le résoudre via /me/accounts.
META_PAGE_ACCESS_TOKEN_NIDAL=
META_PAGE_ACCESS_TOKEN_NIDAL_JUNIOR=
META_IG_USER_ID_NIDAL=
META_IG_USER_ID_NIDAL_JUNIOR=
META_AD_ACCOUNT_ID_NIDAL=
META_AD_ACCOUNT_ID_NIDAL_JUNIOR=
META_PAGE_POST_METRICS=post_media_view,post_total_media_view_unique
# Cache serveur pour le dashboard Meta Live (le navigateur actualise chaque minute)
META_LIVE_CACHE_SECONDS=60
# Analyse Audience/Conversions plus lourde : cache 15 minutes
META_AUDIENCE_CACHE_SECONDS=900
META_MEDIA_ANALYSIS_LIMIT=50
# Nombre de posts Facebook récents analysés dans le bloc Meta Live
META_FACEBOOK_LIVE_POST_LIMIT=50


# --- Automatisation KPI -> IA ---
# Secret dédié au webhook POST /webhooks/kpi-ai
NIDAL_WEBHOOK_SECRET=


# --- Automatisation Meta ---
# Le serveur sauvegarde un snapshot Audience/Ads chaque heure.
META_HOURLY_SYNC_ENABLED=true
META_BACKGROUND_SYNC_SECONDS=300
# Publication Instagram via API nécessite notamment instagram_content_publish.
# Publication Facebook utilise le Page Access Token et pages_manage_posts.
